def options(opt):
    opt.load('compiler_cxx')

def configure(conf):
    conf.load('compiler_cxx')

def build(bld):
    bld.program(source=['resource_test.cpp', '../../../src/cof/vgui/resource.cpp'],
                includes=['../../../src/cof/vgui'], target='resource_test',
                cxxflags=['-std=c++11'] if bld.env.CXX_NAME == 'gcc' else [])
